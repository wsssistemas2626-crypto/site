# Resend (https://resend.com) — envio do formulário de contato
RESEND_API_KEY=
CONTACT_TO_EMAIL=contato@wsssistemas.com.br
# Remetente precisa ser de um domínio verificado no Resend
CONTACT_FROM_EMAIL="WSS Sistemas <site@wsssistemas.com.br>"
# Opcional: e-mail exibido na página de contato
NEXT_PUBLIC_CONTACT_EMAIL=contato@wsssistemas.com.br
# URL pública do site (metadataBase / og:image)
NEXT_PUBLIC_SITE_URL=https://wsssistemas.com.br
